# Go development values. The server never loads this file automatically.
# Source development only. Compose deployments use deploy/.env.example.
# Copy to a private file, replace placeholders, then load explicitly:
#   set -a; . /absolute/path/to/private.env; set +a
ORBIS_DATABASE_URL='postgres://orbis:REPLACE_DATABASE_PASSWORD@127.0.0.1:5432/orbis_dev?sslmode=disable&connect_timeout=5'
ORBIS_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ORBIS_LISTEN_ADDRESS=127.0.0.1:9202
ORBIS_STORAGE_DIR=.dev/storage
# JSON requests and ordinary files use separate byte budgets.
# ORBIS_MAX_BODY_BYTES=8388608
ORBIS_MAX_UPLOAD_BYTES=33554432
ORBIS_PUBLIC_BASE_URL=http://127.0.0.1:9200
ORBIS_MAIL_TRANSPORT=disabled
ORBIS_MAIL_OUTBOX_DIR=.dev/mail-outbox
ORBIS_MAIL_FROM=noreply@example.test
# Optional for a native-only development instance. Required for opening/editing
# documents already activated for CRDT; keep their persisted state and projection.
# ORBIS_COLLABORATION_URL=http://127.0.0.1:9203
# ORBIS_COLLABORATION_KEY=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_BYTES
# Optional locally; required for durable staged imports. No automatic database/service discovery.
# ORBIS_REDIS_URL=redis://127.0.0.1:6379/0
# ORBIS_SMTP_ADDRESS=smtp.example.test:587
# ORBIS_SMTP_SECURITY=starttls
# ORBIS_SMTP_USERNAME=
# ORBIS_SMTP_PASSWORD=
# ORBIS_DEV_API_TARGET=http://127.0.0.1:9202
