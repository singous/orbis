# Orbis 本地开发环境变量示例
#
# 使用方式：
# 1. 复制本文件为 `.env`。
# 2. 按本地环境修改 `.env` 中的值。
# 3. 当前服务读取的是进程环境变量；若直接用 shell 启动，可先执行：
#    set -a; source .env; set +a
#
# 注意：
# - `.env` 会被 Git 忽略，不应提交真实密钥、密码和令牌。
# - `.env.example` 只保留开发示例值和说明。

# ---------------------------------------------------------------------------
# orbis-user-api
# ---------------------------------------------------------------------------

# 共享 PostgreSQL 开发库连接。
# 本项目当前不按服务维护独立数据库，也不默认使用独立 schema。
# 密码不要写入可提交文件，请从本地文档或运维渠道获取后填入 `.env`。
ORBIS_DATABASE_URL=postgresql+asyncpg://orbis-open-dev:<replace-with-dev-db-password>@118.89.168.74:40101/orbis-open-dev

# 可选：仅在确实需要 PostgreSQL schema 命名空间隔离时设置。
# 当前阶段默认留空，表落在 public schema。
# ORBIS_DATABASE_SCHEMA=

# 本地上传文件存储目录。
# 建议使用项目内 ignored 目录，或使用 /tmp 下的临时目录。
ORBIS_STORAGE_DIR=./orbis-user-api/storage/files

# 是否在应用启动时自动创建表。
# 开发环境建议通过 Alembic 管理表结构，保持 false。
# 测试代码可单独覆盖为 true。
ORBIS_AUTO_CREATE_TABLES=false

# JWT access token 签名密钥。
# 本地开发也应使用足够长的随机字符串；生产环境必须替换。
ORBIS_ACCESS_TOKEN_SECRET=replace-with-a-local-access-secret-at-least-32-bytes

# refresh token hash 使用的服务端密钥。
# 生产环境必须和 access token 密钥分开管理。
ORBIS_REFRESH_TOKEN_SECRET=replace-with-a-local-refresh-secret-at-least-32-bytes

# access token 有效期，单位：秒。
ORBIS_ACCESS_TOKEN_TTL_SECONDS=900

# refresh token 有效期，单位：秒。
ORBIS_REFRESH_TOKEN_TTL_SECONDS=2592000

# 邮箱验证码有效期，单位：秒。
ORBIS_EMAIL_CODE_TTL_SECONDS=600

# 同一邮箱同一用途验证码建议重发间隔，单位：秒。
ORBIS_EMAIL_CODE_RESEND_SECONDS=60

# ---------------------------------------------------------------------------
# orbis-user-web
# ---------------------------------------------------------------------------

# Vite 本地开发端口固定为 9200。
# 前端默认通过 `/api` 走 Vite 反代访问 user-api。
ORBIS_USER_WEB_PORT=9200

# user-api 本地开发端口固定为 9201。
# Vite proxy 会把 `http://127.0.0.1:9200/api/*` 转发到该端口。
ORBIS_USER_API_PORT=9201

# 可选：覆盖前端 API 基础路径。
# 默认值是 `/api`，本地开发一般不需要设置。
# VITE_API_BASE_URL=/api
