map $upstream_http_www_authenticate $orbis_registry_authentication {
    "" "";
    default 'Bearer realm="http://${ORBIS_TRANSPORT_ADDRESS}/service/token",service="harbor-registry"';
}

server {
    listen ${ORBIS_TRANSPORT_ADDRESS};
    server_name _;
    client_max_body_size 0;

    location / {
        proxy_pass ${ORBIS_HARBOR_UPSTREAM};
        proxy_set_header Host ${ORBIS_TRANSPORT_ADDRESS};
        proxy_set_header X-Forwarded-Proto http;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_http_version 1.1;
        proxy_hide_header WWW-Authenticate;
        add_header WWW-Authenticate $orbis_registry_authentication always;
        proxy_redirect ~^https?://[^/]+/(.*)$ http://${ORBIS_TRANSPORT_ADDRESS}/$1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_connect_timeout 15s;
        proxy_read_timeout 900s;
        proxy_send_timeout 900s;
    }
}
