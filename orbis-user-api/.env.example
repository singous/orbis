# ============================================================
# orbis-user-api service-local settings template.
# Copy to .env and fill in values. Repo-root .env supplies shared
# middleware (e.g. ORBIS_DATABASE_URL); this file overrides it.
# ============================================================

# Create missing tables on startup (dev convenience; migrations own this in real envs)
ORBIS_AUTO_CREATE_TABLES=true

# Token signing secrets (generate: python -c "import secrets; print(secrets.token_urlsafe(32))")
ORBIS_ACCESS_TOKEN_SECRET=change-me-access-secret
ORBIS_REFRESH_TOKEN_SECRET=change-me-refresh-secret
ORBIS_ACTION_TOKEN_SECRET=change-me-action-secret

# Mail: disabled | outbox | smtp (invitations/ownership transfer need outbox or smtp)
ORBIS_MAIL_TRANSPORT=disabled
