# Docker Compose deployment configuration. The application does not source this file.
# Copy to a private file and select it with docker compose --env-file.
# Generate a fresh 64-character hexadecimal value for each secret on first install.
# Keep existing secrets on upgrades; POSTGRES_PASSWORD only initializes a new volume.
ORBIS_DATABASE_PASSWORD=REPLACE_WITH_RANDOM_HEX_PASSWORD
ORBIS_SIGNING_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Full external URL used by browsers and confirmation emails.
ORBIS_PUBLIC_BASE_URL=https://docs.example.test
# Immutable API and frontend images from the same application release.
ORBIS_API_IMAGE=registry.example.test/orbis-api@sha256:REPLACE_WITH_IMAGE_DIGEST
ORBIS_WEB_IMAGE=registry.example.test/orbis-web@sha256:REPLACE_WITH_IMAGE_DIGEST
ORBIS_COLLABORATION_IMAGE=registry.example.test/orbis-collaboration@sha256:REPLACE_WITH_IMAGE_DIGEST
ORBIS_COLLABORATION_KEY=REPLACE_WITH_AN_INDEPENDENT_RANDOM_SECRET_AT_LEAST_32_BYTES
ORBIS_BIND_ADDRESS=127.0.0.1
ORBIS_PORT=28190

# The built-in PostgreSQL URL is derived from ORBIS_DATABASE_PASSWORD.
# Optional override for an already prepared custom database (URL-encode credentials).
# Changing this URL does not remove the built-in db service or its dependencies.
# ORBIS_DATABASE_URL='postgres://user:ENCODED_PASSWORD@database.example.test:5432/orbis?sslmode=verify-full&connect_timeout=5'

# JSON request and ordinary file budgets are independent; values are bytes.
# ORBIS_MAX_BODY_BYTES=8388608
# ORBIS_MAX_UPLOAD_BYTES=33554432

# disabled, outbox (private local delivery only), or smtp (TLS/STARTTLS).
ORBIS_MAIL_TRANSPORT=disabled
ORBIS_MAIL_FROM=noreply@example.test
# ORBIS_SMTP_ADDRESS=smtp.example.test:587
# ORBIS_SMTP_SECURITY=starttls
# ORBIS_SMTP_USERNAME=
# ORBIS_SMTP_PASSWORD=

# Enable only under a reviewed existing-data conversion plan.
# ORBIS_LEGACY_REFRESH_SECRET=
# ORBIS_LEGACY_ACTION_SECRET=
