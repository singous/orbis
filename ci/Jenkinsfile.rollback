pipeline {
    agent { label 'orbis-builder' }
    options { disableConcurrentBuilds(); timeout(time: 10, unit: 'MINUTES'); buildDiscarder(logRotator(numToKeepStr: '20')) }
    parameters {
        string(name: 'RELEASE_ID', defaultValue: '', description: 'Successful release to restore; blank uses the previous release')
    }
    stages {
        stage('Checkout deployment tooling') { steps { checkout scm } }
        stage('Restore release and verify health') {
            steps {
                withEnv(["ORBIS_ROLLBACK_ID=${params.RELEASE_ID}"]) {
                    sh '''
                        if [ -n "$ORBIS_ROLLBACK_ID" ]; then
                            python3 ci/release.py rollback --runtime-dir "$ORBIS_RUNTIME_DIR" --release-id "$ORBIS_ROLLBACK_ID"
                        else
                            python3 ci/release.py rollback --runtime-dir "$ORBIS_RUNTIME_DIR"
                        fi
                    '''
                }
            }
        }
    }
}
